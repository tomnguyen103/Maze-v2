{
  "name": "echo-maze",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A bright deterministic browser maze with readable Warden tactics and local run records.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "node server.js",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "verify:audit": "node scripts/verify-audit-chain.mjs",
    "prune:rate-limits": "node scripts/prune-rate-limits.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:bundle",
    "check:full": "npm run check && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.25.7",
    "@clerk/express": "^2.1.45",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@vercel/functions": "^3.7.5",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "jayson": {
      "uuid": "11.1.1"
    }
  }
}
