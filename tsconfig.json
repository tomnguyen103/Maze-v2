{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "node"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.js",
    "tests/**/*.js",
    "eslint.config.mjs",
    "vite.config.mjs",
    "playwright.config.mjs"
  ]
}
