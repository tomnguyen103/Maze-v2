# Local development defaults to Ollama and works offline with the bundled deck.
QUESTION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:latest

# Production defaults to Gemini when this key is available.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Public Clerk key embedded by Vite at build time. Leave blank to test guest-only play.
VITE_CLERK_PUBLISHABLE_KEY=

# Server-side Clerk keys used by local Express and Vercel functions. Set all
# Clerk values and DATABASE_URL in Vercel before enabling production sign-in.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signs Clerk `user.deleted` events sent to `/api/clerk-webhook`.
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon pooled connection string. Keep the real value in Vercel, never in Git.
DATABASE_URL=

# Keep false until the production release checklist is approved. The complete
# server-authoritative allowance still runs in tests and staging when true.
RUN_ACCESS_ENFORCEMENT_ENABLED=false

# Lifetime Membership uses Stripe-hosted Checkout in test mode only. Create one
# $5.99 USD one-time Price and subscribe the webhook endpoint to the events in
# docs/lifetime-membership-operations.md. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
ECHO_MAZE_APP_ORIGIN=http://localhost:3000

# --- Security ---------------------------------------------------------------

# Salts the request-address hash the rate limiter and audit log key on. Unset,
# the salt is derived from DATABASE_URL, which logs a warning: set a long random
# value in production so an ip_hash cannot be reversed by guessing addresses.
REQUEST_ADDRESS_SALT=

# Honour `x-forwarded-for` when identifying a caller. True ONLY behind a proxy
# that overwrites the header (Vercel does). Anywhere else it lets a caller spoof
# its address past the rate limiter, so false is the safe default.
TRUST_PROXY_HEADERS=false

# Shared secret for `/api/internal/*`, which Vercel cron calls as
# `Authorization: Bearer $CRON_SECRET`. Unset closes the endpoint rather than
# opening it, so scheduled webhook retries and prunes simply never run.
CRON_SECRET=

# --- Observability ----------------------------------------------------------
# Every knob below is off when unset. Nothing here is required to run the game.

# Pino level for structured request logs: fatal|error|warn|info|debug|trace.
# Defaults to info.
LOG_LEVEL=info

# OpenTelemetry traces. Unset means the SDK is never imported — zero overhead.
# Setting the endpoint turns on http + pg instrumentation; the exporter reads
# the rest of the standard OTEL_EXPORTER_OTLP_* variables itself, including
# OTEL_EXPORTER_OTLP_HEADERS for a vendor auth token.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Sentry error tracking. Server DSN and browser DSN are separate projects on
# purpose; either can be left unset. VITE_ values are embedded at build time.
SENTRY_DSN=
VITE_SENTRY_DSN=
# Tags browser errors with a release. Usually the deploy's commit SHA.
VITE_SENTRY_RELEASE=

# PostHog product events. Unset means events are dropped, never queued.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Injected by the platform, not by this file -----------------------------
# NODE_ENV and VERCEL_ENV pick the production security-header and question
# provider posture; VERCEL_GIT_COMMIT_SHA becomes the version in /api/health.
# Vercel sets all three. Locally, NODE_ENV comes from the npm script that runs.
