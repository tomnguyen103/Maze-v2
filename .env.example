# Local development defaults to Ollama and works offline with the bundled deck.
QUESTION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:latest

# Production defaults to Gemini when this key is available.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Public Clerk key embedded by Vite at build time.
VITE_CLERK_PUBLISHABLE_KEY=

# Server-side Clerk keys used by local Express and Vercel functions.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon pooled connection string. Keep the real value in Vercel, never in Git.
DATABASE_URL=
